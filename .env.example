# Hunter — one always-on HTTP service. A hunt is started by a direct API call and
# runs in-process; there is no queue and no Redis.

# The one secret shared with the gateway worker. Set the same value on the worker
# with `wrangler secret put HUNTER_SECRET`. It is how the worker proves a request
# is its own, and how Hunter reaches D1 through the worker.
HUNTER_SECRET=

# matterai.so: the inference gateway the attacker, verifier, and judge brains call
# through. Required — a run fails closed at intake without it, rather than the
# service refusing to start, so a misconfigured deploy is visible per-run.
MATTERAI_API_KEY=
# MATTERAI_BASE_URL=https://api2.matterai.so/v1

# Model selection, per role.
ATTACKER_MODEL=frost-abliterated-cyber-max-1
VERIFIER_MODEL=frost-abliterated-cyber-max-1
JUDGE_MODEL=fastino/gliner2.5-decide-free

# Clef (Cloudflare's model) is not live yet. Leave this unset (matterai) until it
# ships; setting it to "clef" makes every model call fail clearly instead of
# guessing at a contract that does not exist.
# MODEL_PROVIDER=matterai

# --- Agent tools ---------------------------------------------------------------
# The agent always has read-only tools (read_file / list_dir / search). The
# privileged tools:
#
# bash: runs commands against the cloned code ONLY inside an isolated container,
# never on the host. The sandbox is always on — it is not gated by an env var. The
# host must provide a container runtime (Docker, ideally with the gVisor runtime);
# a command fails trying to start the sandbox if none is present. The image and OCI
# runtime are configurable:
# SANDBOX_IMAGE=node:22-slim
# SANDBOX_OCI_RUNTIME=runsc        # gVisor; empty uses the default Docker runtime

# web_search: background lookups via Fireworks. Disabled until the key is set.
# FIREWORKS_API_KEY=
# FIREWORKS_BASE_URL=https://api.fireworks.ai

# Optional.
# WORKER_URL=https://api.frostwolf.app
PORT=6888
RUN_TIMEOUT_MS=14400000
VERIFY_N=1
# COST_PER_1K_TOKENS_USD=0.002

# --- Generator runtime ---------------------------------------------------------
# What drives the recon/synthesis/verify generators. "orbcode" is the DEFAULT and
# the only wired real runtime — it runs the orbcode harness and never silently
# falls back to the built-in loop. "claude"/"codex" are reserved and fail clearly
# until wired. "internal" is the built-in loop, for tests only.
# AGENT_RUNTIME=orbcode
# ORBCODE_BIN=/path/to/orbcode/bin/orbcode.js   # required for orbcode; bundle it in the image

# --- JEV judge backend ---------------------------------------------------------
# The judges that gate each stage. "skip" (the DEFAULT) calls no model: it clears
# every gate so recon → synthesis → validate → verify runs end to end while the
# judge is being reworked. The generators and verify's independent re-derivation
# still do their own work, so this is not "promote everything" — but it is not a
# truth gate either. Flip to a real judge once it is sound:
#   "chat"   — the LLM above reasons out each verdict.
#   "gliner" — a GLiNER2.5-Decide structured-decision service (fast, JEV-shaped).
# Note: in testing, GLiNER2.5-Decide did not discriminate well on open-ended code
# exploitability, so prefer "chat" for the truth gates; use "gliner" where the
# decision is a clean classification (or once it's tuned for this).
# JUDGE_PROVIDER=chat
# JUDGE_BASE_URL=https://glimulit2-5-decide-oma.frostwolf.app
