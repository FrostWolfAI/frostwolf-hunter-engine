# Hunter.

# Redis: the run queue (a native stream, no queueing library) and the live log.
# Hunter connects directly.
REDIS_URL=redis://127.0.0.1:6379

# The one secret shared with the gateway worker. Set the same value on the worker
# with `wrangler secret put HUNTER_SECRET`. It is how the worker proves a request
# is its own, and how Hunter reaches D1 through the worker.
HUNTER_SECRET=

# matterai.so: the inference gateway the attacker, verifier, and judge brains call
# through. Required — a run fails closed at intake without it, rather than the
# service refusing to start, so a misconfigured deploy is visible per-run.
MATTERAI_API_KEY=
# MATTERAI_BASE_URL=https://api2.matterai.so/v1

# Model selection, per role. Required; there is no hardcoded fallback model id.
# ATTACKER_MODEL and VERIFIER_MODEL should be different models — that is what
# makes an independent reproduction a genuine second opinion.
ATTACKER_MODEL=glm-5.3
VERIFIER_MODEL=glm-5.3
JUDGE_MODEL=glm-5.3

# Clef (Cloudflare's model) is not live yet. Leave this unset (matterai) until it
# ships; setting it to "clef" makes every model call fail clearly instead of
# guessing at a contract that does not exist.
# MODEL_PROVIDER=matterai

# --- Agent tools ---------------------------------------------------------------
# The agent always has read-only tools (read_file / list_dir / search). The two
# privileged tools are off by default and must never run on the host:
#
# bash: runs commands against the cloned code ONLY inside an isolated container.
# Leave SANDBOX_RUNTIME=none (the default) and bash is disabled. Set it to "docker"
# — ideally with the gVisor runtime — to enable it on a host that has the runtime.
# SANDBOX_RUNTIME=docker
# SANDBOX_IMAGE=node:22-slim
# SANDBOX_OCI_RUNTIME=runsc        # gVisor; empty uses the default Docker runtime

# web_search: background lookups via Fireworks. Disabled until the key is set.
# FIREWORKS_API_KEY=
# FIREWORKS_BASE_URL=https://api.fireworks.ai

# Optional.
# WORKER_URL=https://api.frostwolf.app
# PORT=8080
# CONCURRENCY=2
# RUN_TIMEOUT_MS=1800000
# VERIFY_N=3
# COST_PER_1K_TOKENS_USD=0.002
# MAX_RUN_TOKENS=1500000           # per-run token budget; the agent stops when spent

# --- JEV judge backend ---------------------------------------------------------
# The judges that gate each stage. "chat" (default) uses the LLM above. "gliner"
# routes decisions to a GLiNER2.5-Decide structured-decision service (fast, JEV-shaped).
# Note: in testing, GLiNER2.5-Decide did not discriminate well on open-ended code
# exploitability, so "chat" is the safe default for the truth gates; use "gliner"
# where the decision is a clean classification (or once it's tuned for this).
# JUDGE_PROVIDER=gliner
# JUDGE_BASE_URL=https://glimulit2-5-decide-oma.frostwolf.app
